# In Vercel unter Settings → Environment Variables eintragen (nicht in diese Datei!)
# Werte aus Supabase: Project Settings → API Keys / Data API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_…) oder legacy "anon" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "Secret key" (sb_secret_…) oder legacy "service_role" key – geheim halten!
SUPABASE_SERVICE_ROLE_KEY=

# Anzeigename der App
NEXT_PUBLIC_APP_NAME=Schöttes Bauportal

# E-Mail-Benachrichtigung (Resend)
RESEND_API_KEY=
MAIL_FROM=Schöttes Bauportal <portal@schoettes.com>
APP_URL=https://portal.schoettes.com
# Geheimwort für den Zeitplan (gleicher Wert in supabase/benachrichtigung_zeitplan.sql)
CRON_SECRET=
